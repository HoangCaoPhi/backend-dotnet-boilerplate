{
  "ConnectionStrings": {
    "Database": "Host=localhost;Database=boilerplate;Username=postgres;Password=postgres"
  },
  "UserService": {
    "BaseUrl": "https://user-service.internal"
  },
  "Webhook": {
    "Url": "https://webhook.internal/placeholder"
  },
  "Jwt": {
    "Issuer": "urn:boilerplate:user-service",
    "Audience": "urn:boilerplate:todo-api",
    "SigningKey": "dev-jwt-signing-key-change-me-in-production-32-bytes-min"
  },
  "Integration": {
    "ReplayWindowMinutes": 5,
    "ReportingService": {
      "ClientId": "reporting-service"
    },
    "MobileApp": {
      "ClientId": "mobile-app-1",
      "ClientSecret": "dev-mobile-app-1-secret"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
